# Copy to `.env` and adjust. `docker compose` reads it for the ${VARIABLES} in docker-compose.yml,
# and `manage.py` / gunicorn read it too (real environment variables always win over this file).
# Never commit the real `.env`.

# --- Required for production (config.settings.production refuses to start without them) --------
# 50+ random characters:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Comma-separated host names this API answers to (127.0.0.1/localhost are always allowed too).
DJANGO_ALLOWED_HOSTS=api.example.org
DATABASE_URL=postgres://portal:change-me@localhost:5432/portal

# --- Which settings module (default: production for gunicorn, local for manage.py in development)
# DJANGO_SETTINGS_MODULE=config.settings.local

# --- Browser access ---------------------------------------------------------------------------
# Origins of the frontend, comma separated. No wildcard: the API uses bearer tokens, not cookies.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- HTTPS (production settings) --------------------------------------------------------------
# TLS normally ends at a reverse proxy that sets X-Forwarded-Proto; only expose the app through
# a proxy that overwrites that header. Set false when the app itself is reached over plain HTTP.
DJANGO_BEHIND_PROXY=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# Opt-in, slow to undo: submit the domain to browsers' HSTS preload lists.
DJANGO_SECURE_HSTS_PRELOAD=false

# --- Sessions and abuse protection ------------------------------------------------------------
# Lifetime of a sign-in, seconds (8 hours).
ACCESS_TOKEN_TTL_SECONDS=28800
# Sign-in / registration attempts per client address. Format: <count>/<sec|min|hour|day>.
THROTTLE_AUTH_LOGIN=20/min
THROTTLE_AUTH_REGISTER=10/min
# Number of reverse proxies in front of the app (decides which X-Forwarded-For entry is the
# client). 0 = ignore the header and use the socket address; a wrong value lets clients spoof it.
NUM_PROXIES=0
# Throttle counters live in this cache. The default is per-process memory; with several workers
# or replicas use a shared cache, e.g. redis://redis:6379/1 (needs `pip install redis`) or
# dbcache://portal_throttle (then run `python manage.py createcachetable` once).
# CACHE_URL=locmemcache://portal-throttle
# Largest request body accepted, bytes.
API_MAX_BODY_BYTES=65536

# --- Password hashing (Argon2id; defaults follow OWASP's 19 MiB / t=2 / p=1 profile) ------------
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST_KIB=19456
ARGON2_PARALLELISM=1

# --- Database ---------------------------------------------------------------------------------
# Seconds a connection is reused (0 = a new one per request).
DB_CONN_MAX_AGE=60
# Kill any single statement that runs longer than this many milliseconds (0 = no limit).
DB_STATEMENT_TIMEOUT_MS=30000

# --- Demo tooling: leave OFF anywhere that holds real data -----------------------------------
# POST /api/demo/reset/ wipes everything back to the seed data.
ENABLE_DEMO_RESET=false
# /api/schema/ (OpenAPI) and /api/docs/ (Swagger UI).
ENABLE_API_DOCS=false
# The container entrypoint (entrypoint.sh) creates the demo accounts, which share a PUBLIC
# password, when this is true.
SEED_DEMO_DATA=false

# --- Container start-up (entrypoint.sh) ------------------------------------------------------
RUN_MIGRATIONS=true
SYNC_CATALOG=true
DB_WAIT_TIMEOUT=60

# --- Gunicorn (gunicorn.conf.py) --------------------------------------------------------------
# WEB_CONCURRENCY=9
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=45
# GUNICORN_GRACEFUL_TIMEOUT=30
# GUNICORN_KEEPALIVE=5
# GUNICORN_MAX_REQUESTS=2000
# GUNICORN_MAX_REQUESTS_JITTER=200
# GUNICORN_LOG_LEVEL=info
# GUNICORN_BIND=0.0.0.0:8000
# Peers allowed to set X-Forwarded-*: the address(es) of YOUR reverse proxy.
# FORWARDED_ALLOW_IPS=127.0.0.1

# --- Logging ----------------------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Docker compose conveniences (docker-compose.yml only) ------------------------------------
# POSTGRES_PASSWORD=portal
# API_PORT=8000
# DB_PORT=5432
